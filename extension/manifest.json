{
  "manifest_version": 3,
  "name": "My Safe - الخزنة الرقمية",
  "version": "1.0.0",
  "description": "إضافة My Safe لملء كلمات المرور والحسابات تلقائياً بأمان تام.",
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "My Safe - الخزنة الرقمية"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ]
}
