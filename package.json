{
  "name": "my-safe",
  "version": "1.0.0",
  "description": "My Safe - Professional Secure Desktop Password Manager & Vault",
  "type": "module",
  "main": "dist-electron/index.js",
  "scripts": {
    "start": "electron .",
    "dev": "vite",
    "build": "tsc && vite build && powershell -Command \"New-Item -ItemType Directory -Force -Path dist-electron/biometrics; Copy-Item src/main/biometrics/winHello.ps1 dist-electron/biometrics/winHello.ps1 -Force; Copy-Item resources/tray.png dist-electron/tray.png -Force\"",
    "build:extensions": "powershell -ExecutionPolicy Bypass -File scripts/buildExtensions.ps1",
    "dist": "npm run build && npm run build:extensions && electron-builder --win",
    "preview": "vite preview"
  },
  "keywords": [
    "password-manager",
    "vault",
    "security",
    "encryption",
    "electron",
    "react",
    "argon2",
    "aes-gcm"
  ],
  "author": "Eng. Mohammed Al-Gunaid <https://github.com/hmo175>",
  "homepage": "https://github.com/hmo175/my-safe",
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vite-plugin-electron": "^1.2.0",
    "vite-plugin-electron-renderer": "^1.0.0"
  },
  "dependencies": {
    "hash-wasm": "^4.13.0",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "build": {
    "appId": "com.mysafe.vault",
    "productName": "My Safe",
    "copyright": "Copyright © 2026 Eng. Mohammed Al-Gunaid",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "resources/**/*"
    ],
    "asarUnpack": [
      "dist-electron/biometrics/**/*"
    ],
    "extraResources": [
      { "from": "extension", "to": "extension" },
      { "from": "extension-firefox", "to": "extension-firefox" }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "My Safe"
    }
  }
}
